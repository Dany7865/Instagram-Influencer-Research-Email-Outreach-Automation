# ---------- Claude ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ---------- Brand / campaign (edit for your chosen brand) ----------
BRAND_NAME=GlowLeaf Organics
BRAND_DESCRIPTION=GlowLeaf Organics is an Indian clean-beauty brand making vegan, cruelty-free skincare with plant-based ingredients.
CAMPAIGN_BRIEF=Winter Glow campaign: we are looking for creators to try our new Vitamin C + Aloe serum range and share honest reels/stories. We offer a free product kit plus a paid collaboration (budget discussed per creator) and an affiliate code.
TARGET_NICHE=skincare, beauty, wellness, self-care, clean beauty
TARGET_KEYWORDS=skincare,beauty,wellness,self-care,clean beauty,vegan,organic,glow,makeup
TARGET_LOCATION=India
MIN_FOLLOWERS=100000
MAX_FOLLOWERS=50000000
MIN_SCORE=60

# ---------- Sender identity (shown in every email footer) ----------
SENDER_NAME=Danyal Ali
SENDER_TITLE=Influencer Partnerships
SENDER_EMAIL=your.gmail@gmail.com
COMPANY_ADDRESS=Your Company, Street, City, PIN, Country

# ---------- Sending policy ----------
DAILY_SEND_LIMIT=20
SEND_DELAY_SECONDS=30
FOLLOWUP1_DAYS=4
FOLLOWUP2_DAYS=6

# ---------- Instagram Graph API (your own Business/Creator account) ----------
IG_ACCESS_TOKEN=
IG_USER_ID=

# ---------- Gmail: put OAuth client file next to main.py as credentials.json ----------
GMAIL_CREDENTIALS_FILE=credentials.json

# ---------- Google Sheets (service account) ----------
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Force a mock for any one integration: MOCK_LLM=1  MOCK_INSTAGRAM=1  MOCK_GMAIL=1  MOCK_SHEETS=1
